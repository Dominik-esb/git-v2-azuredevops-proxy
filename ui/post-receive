#!/bin/sh
# Installed into every mirror by start.sh: forwards each pushed ref to Azure DevOps.
UPSTREAM=$(git config remote.origin.url)
echo "[proxy] Forwarding push to upstream..."
STATUS=0
while read -r _oldrev newrev refname; do
    if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
        git push "$UPSTREAM" ":${refname}" 2>&1 \
            && echo "[proxy] Deleted   ${refname}" \
            || { echo "[proxy] WARN: failed to delete ${refname}" >&2; STATUS=1; }
    else
        git push "$UPSTREAM" "${newrev}:${refname}" 2>&1 \
            && echo "[proxy] Forwarded ${refname}" \
            || { echo "[proxy] WARN: failed to forward ${refname}" >&2; STATUS=1; }
    fi
done
# Status page: last forwarded push for this repo. The repo's path is its directory under /repos.
if [ -d /tmp/status ]; then
    path="${PWD#/repos/}"; path="${path%.git}"
    [ "$STATUS" = 0 ] && result=ok || result=failed
    printf '%s %s\n' "$(date +%s)" "$result" > "/tmp/status/$(printf '%s' "$path" | tr '/' '~').push"
    /usr/local/bin/git-proxy-status || true
fi
exit "$STATUS"
